CREATE TABLE IF NOT EXISTS Vouchers_StockItems (
    GUID TEXT UNIQUE,
    VCH_GUID TEXT,
    VchType TEXT,
    VchName TEXT,
    DATE TEXT,
    VOUCHERNUMBER TEXT,
    SRNO INTEGER,
    CM1 TEXT,
    CM2 TEXT,
    CM3 TEXT,
    CM4 TEXT,
    CM5 TEXT,
    D1 REAL,
    D2 REAL,
    D3 REAL,
    D4 REAL,
    D5 REAL,
    E1 TEXT,
    E2 TEXT,
    E3 TEXT,
    E4 TEXT,
    E5 TEXT,
    E6 TEXT,
    E7 TEXT,
    E8 TEXT,
    E9 TEXT,
    E10 TEXT
);

stockReportList:
SELECT
    CM1 AS Item_Name,
    CM3 AS Item_Unit,
    GUID AS Guid,
    SUM(D1) AS Item_Qty,
    SUM(D3) AS Item_Amt
FROM Vouchers_StockItems
GROUP BY CM1, CM3
ORDER BY CM1;


getStockItemById:
SELECT
CM2 AS Item_Godown,
CM3 AS Item_Unit,
Sum(D1) AS Item_Qty,
Sum(D3) AS Item_Amt
 FROM Vouchers_StockItems
 WHERE CM1 = ? GROUP BY CM2,CM3 ORDER BY CM2;


ledgerReportList:
SELECT
  VL.*,
 Vouchers.PARTYLEDGERNAME AS AccountName
FROM Vouchers_StockItems AS VL LEFT JOIN Vouchers ON VL.VCH_GUID = Vouchers.GUID
WHERE VL.CM1 = ?
  AND VL.DATE >= ?
  AND VL.DATE <= ? AND VL.VchType NOT IN ('Sales Order','Purchase Order')
ORDER BY VL.DATE, VL.VOUCHERNUMBER;


ledgerOpeningBalance:
SELECT Sum(D1) AS OpeningBal, Sum(D3) AS OpeningAmt FROM Vouchers_StockItems WHERE CM1=? AND DATE<?;


godownWiseClosingStockList:
SELECT
    SUM(pps.Value1) AS Item_Qty,
    SUM(pps.Value3) AS Item_Amt,
    g.Name          AS Item_Godown,
    ''              AS UnitName,
    g.Name          AS GodownName
FROM ProductStock AS pps
JOIN GodownMaster AS g
    ON g.GUID = pps.MasterCode2
LEFT JOIN Products AS p
    ON p.GUID = pps.MasterCode1
WHERE
  (:filterGroup = 0 OR p.GroupCode IN :groupCodes)
                          AND (:filterExclude = 0 OR p.GUID NOT IN :excludeGuids)
                          AND (:filterGodown = 0 OR pps.MasterCode2 IN :godownCodes)
GROUP BY g.GUID
ORDER BY g.Name;


 godownWiseOnEnterList:
SELECT
    SUM(pps.Value1) AS Item_Qty,
    SUM(pps.Value3) AS Item_Amt,
    g.Name          AS Item_Godown,
    ''              AS UnitName,
    g.Name          AS GodownName,
    p.Name          AS ItemName,
    p.GroupName     AS GroupName
FROM ProductStock AS pps
JOIN GodownMaster AS g
    ON g.GUID = pps.MasterCode2
LEFT JOIN Products AS p
    ON p.GUID = pps.MasterCode1
WHERE g.Name = ? AND    (:filterGroup = 0 OR p.GroupCode IN :groupCodes)
                         AND (:filterExclude = 0 OR p.GUID NOT IN :excludeGuids)
                         AND (:filterGodown = 0 OR pps.MasterCode2 IN :godownCodes)
GROUP BY g.GUID, p.GUID
ORDER BY p.Name;

ledgerStockItemList:
SELECT SRNO,CM1 AS Item_Name,D1 AS Qty,CM3 AS Unit,D2 AS Rate,D4 AS Amt FROM Vouchers_StockItems WHERE VCH_GUID=? ORDER BY SRNO;