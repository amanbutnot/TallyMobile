CREATE TABLE Vouchers_BILLALLOCATIONS (
    GUID TEXT NOT NULL UNIQUE,
    VCH_GUID TEXT,
    VCHTYPE TEXT,
    DATE TEXT,
    DUEDATE TEXT,
    BILLNUMBER TEXT,
    SRNO INTEGER,
    CM1 TEXT,
    CM2 TEXT,
    CM3 TEXT,
    BILLID REAL,
    D1 REAL,
    D2 REAL,
    E1 TEXT,
    E2 TEXT,
    PRIMARY KEY(GUID)
);

deleteOldBillAllocation:
DELETE FROM Vouchers_BILLALLOCATIONS
WHERE VCH_GUID = :guid;

insertBillAllocation:
INSERT OR IGNORE INTO Vouchers_BILLALLOCATIONS(
    GUID,
    VCH_GUID,
    VCHTYPE,
    DATE,
    DUEDATE,
    BILLNUMBER,
    SRNO,
    CM1,
    CM2,
    CM3,
    BILLID,
    D1,
    D2,
    E2
)
VALUES (
    :guid,
    :vch_guid,
    :vchtype,
    :date,
    :duedate,
    :billnumber,
    :srno,
    :cm1,
    :cm2,
    :cm3,
    :billid,
    :d1,
    :d2,
    :e2
);


outstandingDate:
SELECT MIN(DATE) FROM Vouchers_BILLALLOCATIONS;

billReceivableList:
SELECT
    V.VCH_GUID,
    V.DATE AS date,
    V.VCHTYPE AS vchType,
    V.BILLNUMBER AS billNumber,
    V.CM1 AS cm1,
    V.DUEDATE AS dueDate,    V.BILLID AS billid,
    V.D1 AS d1,
    Adj.AdjustmentAmount AS adjustmentAmount,lm.GroupName
FROM Vouchers_BILLALLOCATIONS AS V
INNER JOIN (
    SELECT BILLID, ROUND(SUM(D1),3) AS AdjustmentAmount
    FROM Vouchers_BILLALLOCATIONS
    GROUP BY BILLID
) AS Adj
ON V.BILLID = Adj.BILLID
LEFT JOIN LedgerMaster AS lm ON lm.Name = V.CM1
WHERE V.CM2 IN ('New Ref', 'Advance')
  AND (:showToggle = 0 OR V.D1 < 0)
  AND  V.DATE>=? AND V.DATE<=?
  AND (:showToggle = 0 OR Adj.AdjustmentAmount < 0)
 AND (:filterCm3 = 0 OR V.CM3 IN :cm3) AND CM1 IN (
 SELECT Name
FROM LedgerMaster
 WHERE (:groupFilter = 0 OR GroupCode IN ?)
AND (:excludeFilter = 0 OR GUID NOT IN ?)
)
ORDER BY V.DATE, V.CM1;


billByBillList:
SELECT
    V.VCH_GUID,
    V.DATE AS date,
    V.VCHTYPE AS vchType,
    V.BILLNUMBER AS billNumber,
    V.CM1 AS cm1,
    V.DUEDATE AS dueDate,
    V.BILLID AS billid,
    V.D1 AS d1,
    Adj.AdjustmentAmount AS adjustmentAmount,lm.GroupName
FROM Vouchers_BILLALLOCATIONS AS V
INNER JOIN (
    SELECT BILLID, ROUND(SUM(D1),3) AS AdjustmentAmount
    FROM Vouchers_BILLALLOCATIONS WHERE 1=1 AND (:filterGuid = 0 OR VCH_GUID <>:uniqueID)
    GROUP BY BILLID
) AS Adj
ON V.BILLID = Adj.BILLID
LEFT JOIN LedgerMaster AS lm ON lm.Name = V.CM1
WHERE V.CM2 IN ('New Ref', 'Advance')
  AND V.D1 < 0
  AND V.CM1 =?
  AND Adj.AdjustmentAmount < 0  AND (:filterCm3 = 0 OR V.CM3 IN :cm3)

ORDER BY V.DATE, V.CM1;

billByPayList:
SELECT
    V.VCH_GUID,
    V.DATE AS date,
    V.VCHTYPE AS vchType,
    V.BILLNUMBER AS billNumber,
    V.CM1 AS cm1,
    V.DUEDATE AS dueDate,
    V.BILLID AS billid,
    V.D1 AS d1,
    Adj.AdjustmentAmount AS adjustmentAmount,lm.GroupName
FROM Vouchers_BILLALLOCATIONS AS V
INNER JOIN (
    SELECT BILLID, ROUND(SUM(D1),3) AS AdjustmentAmount
    FROM Vouchers_BILLALLOCATIONS WHERE 1=1 AND (:filterGuid = 0 OR VCH_GUID <>:uniqueID)
    GROUP BY BILLID
) AS Adj
ON V.BILLID = Adj.BILLID
LEFT JOIN LedgerMaster AS lm ON lm.Name = V.CM1
WHERE V.CM2 IN ('New Ref', 'Advance')
  AND V.D1 > 0
  AND V.CM1 =?
  AND Adj.AdjustmentAmount > 0  AND (:filterCm3 = 0 OR V.CM3 IN :cm3)

ORDER BY V.DATE, V.CM1;


billReceivableLedgerList:
SELECT
    V.VCH_GUID,
    V.DATE AS date,
    V.VCHTYPE AS vchType,
    V.BILLNUMBER AS billNumber,    V.BILLID AS billid,
    V.CM1 AS cm1,
    V.DUEDATE AS dueDate,
    V.D1 AS d1,
    Adj.AdjustmentAmount AS adjustmentAmount,lm.GroupName
FROM Vouchers_BILLALLOCATIONS AS V
INNER JOIN (
    SELECT BILLID, ROUND(SUM(D1),3) AS AdjustmentAmount
    FROM Vouchers_BILLALLOCATIONS
    GROUP BY BILLID
) AS Adj
ON V.BILLID = Adj.BILLID
LEFT JOIN LedgerMaster AS lm ON lm.Name = V.CM1
WHERE V.CM2 IN ('New Ref', 'Advance')
  AND (:showToggle = 0 OR V.D1 < 0)
  AND  V.DATE>=? AND V.DATE<=?
  AND V.CM1 =?
  AND (:showToggle = 0 OR Adj.AdjustmentAmount < 0)   AND (:filterCm3 = 0 OR V.CM3 IN :cm3)

ORDER BY V.DATE, V.CM1;


billPayableList:
SELECT
    V.VCH_GUID,
    V.DATE AS date,
    V.VCHTYPE AS vchType,
    V.BILLNUMBER AS billNumber,    V.BILLID AS billid,
    V.CM1 AS cm1,
    V.DUEDATE AS dueDate,
    V.D1 AS d1,
    Adj.AdjustmentAmount AS adjustmentAmount,lm.GroupName
FROM Vouchers_BILLALLOCATIONS AS V
INNER JOIN (
    SELECT BILLID, ROUND(SUM(D1),3) AS AdjustmentAmount
    FROM Vouchers_BILLALLOCATIONS
    GROUP BY BILLID
) AS Adj
ON V.BILLID = Adj.BILLID
LEFT JOIN LedgerMaster AS lm ON lm.Name = V.CM1
WHERE V.CM2 IN ('New Ref', 'Advance')
  AND (:showToggle = 0 OR V.D1 > 0)
  AND  V.DATE>=? AND V.DATE<=?
  AND (:showToggle = 0 OR Adj.AdjustmentAmount > 0)   AND (:filterCm3 = 0 OR V.CM3 IN :cm3) AND CM1 IN (
                                                                      SELECT Name
                                                                     FROM LedgerMaster
                                                                      WHERE (:groupFilter = 0 OR GroupCode IN ?)
                                                                     AND (:excludeFilter = 0 OR GUID NOT IN ?)
                                                                     )

ORDER BY V.DATE, V.CM1;


billPayableLedgerList:
SELECT
    V.VCH_GUID,
    V.DATE AS date,
    V.VCHTYPE AS vchType,
    V.BILLNUMBER AS billNumber,    V.BILLID AS billid,
    V.CM1 AS cm1,
    V.DUEDATE AS dueDate,
    V.D1 AS d1,
    Adj.AdjustmentAmount AS adjustmentAmount,lm.GroupName
FROM Vouchers_BILLALLOCATIONS AS V
INNER JOIN (
    SELECT BILLID, ROUND(SUM(D1),3) AS AdjustmentAmount
    FROM Vouchers_BILLALLOCATIONS
    GROUP BY BILLID
) AS Adj
ON V.BILLID = Adj.BILLID
LEFT JOIN LedgerMaster AS lm ON lm.Name = V.CM1
WHERE V.CM2 IN ('New Ref', 'Advance')
  AND (:showToggle = 0 OR V.D1 > 0)
  AND  V.DATE>=? AND V.DATE<=?
  AND V.CM1 =?
AND (:showToggle = 0 OR Adj.AdjustmentAmount > 0)   AND (:filterCm3 = 0 OR V.CM3 IN :cm3)

ORDER BY V.DATE, V.CM1;


outstandingGroupList:
SELECT
    V.CM1 AS Party,
    CASE
        WHEN :mode = 0 THEN SUM(V.D1) * -1
        WHEN :mode = 1 THEN SUM(V.D1)
    END AS PenAmt
FROM Vouchers_BILLALLOCATIONS V
WHERE V.BILLID IN (
    SELECT BILLID
    FROM Vouchers_BILLALLOCATIONS
    WHERE CM2 IN ('New Ref', 'Advance')
      AND DATE >= ?
      AND DATE <= ?
      AND (:filterCm3 = 0 OR CM3 IN :cm3)
      AND CM1 IN (
          SELECT Name
          FROM LedgerMaster
          WHERE (:filterGroupCode = 0 OR GroupCode IN :groupCode)
            AND (:excludeFilter = 0 OR GUID NOT IN ?)
      )
    GROUP BY BILLID
    HAVING
        -- ✅ THIS is the correct place for your logic
        :showToggle = 0
        OR (:mode = 0 AND SUM(D1) < 0)
        OR (:mode = 1 AND SUM(D1) > 0)
)
GROUP BY V.CM1
HAVING SUM(V.D1) <> 0
ORDER BY V.CM1;

