CREATE TABLE IF NOT EXISTS LedgerPricing (
    GUID INTEGER NOT NULL ,
    Name TEXT,
    MobileNo TEXT NOT NULL,
    L6 REAL
);

selectChangePrice:
SELECT L6, 1 AS rectype
FROM LedgerPricing
WHERE MobileNo = :mobileno AND L6 > 100;

existsByMobile:
SELECT COUNT(*)
FROM LedgerPricing
WHERE MobileNo = :mobileno;

selectByMobile:
SELECT * FROM LedgerPricing WHERE TRIM(MobileNo) = TRIM(:mobileno) LIMIT 1;

insertLedgerPricing:
INSERT OR REPLACE INTO LedgerPricing(
    GUID,
    Name,
    MobileNo,
    L6
)
VALUES(
    :guid,
    :name,
    :mobileno,
    :l6
);
