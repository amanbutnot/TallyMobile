CREATE TABLE LedgerMaster (
    Code INTEGER PRIMARY KEY,
    Name TEXT,
    Alias TEXT,
    GroupName TEXT,
    GroupCode REAL,
    OpBal REAL,
    Address1 TEXT,
    Address2 TEXT,
    Address3 TEXT,
    Address4 TEXT,
    Country TEXT,
    State TEXT,
    TypeOfDealer TEXT,
    GSTIN TEXT,
    Email TEXT,
    MobileNo TEXT,
    BankName TEXT,
    AlterID INTEGER,
    GUID TEXT UNIQUE,
    PanNo TEXT,
    L1 REAL,
    L2 REAL,
    L3 REAL,
    L4 REAL,
    L5 REAL
);

existingAccounts:
SELECT GUID FROM LedgerMaster WHERE (Name = :name1 OR Alias = :alias1) OR (Name = :name2 OR Alias = :alias2);


insertLedger:
INSERT INTO LedgerMaster(
    Code,
    Name,
    Alias,
    GroupName,
    GroupCode,
    OpBal,
    Address1,
    Address2,
    Address3,
    Address4,
    Country,
    State,
    TypeOfDealer,
    GSTIN,
    Email,
    MobileNo,
    BankName,
    AlterID,
    GUID,
    PanNo,
    L1,
    L2,
    L3,
    L4,
    L5
)
VALUES(
    :code,
    :name,
    :alias,
    :groupName,
    :groupCode,
    :opBal,
    :address1,
    :address2,
    :address3,
    :address4,
    :country,
    :state,
    NULL,
    :gstin,
    :email,
    :mobileNo,
    NULL,
    :alterId,
    :guid,
    :panNo,
    1,
    1,
    1,
    1,
    1
);

-- All filters
selectAllFilterAGRP:
SELECT * FROM LedgerMaster
WHERE GroupCode IN ? AND GUID NOT IN ?
ORDER BY Name;

-- Only GroupCode filter
selectByGroupCode:
SELECT * FROM LedgerMaster
WHERE GroupCode IN ?
ORDER BY Name;

-- Only GUID exclusion
selectExcludingGuid:
SELECT * FROM LedgerMaster
WHERE GUID NOT IN ?
ORDER BY Name;

-- No filters
selectAll:
SELECT * FROM LedgerMaster
ORDER BY Name;

selectNameFromGuid:
SELECT Name
 FROM LedgerMaster
 WHERE GUID = ?;

 selectByGuid:
 SELECT * FROM LedgerMaster WHERE GUID = ?;