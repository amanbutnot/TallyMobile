CREATE TABLE LedgerMaster (
    Code INTEGER PRIMARY KEY,
    Name TEXT,
    Alias TEXT,
    GroupName TEXT,
    GroupCode REAL,
    OpBal REAL,
    Address1 TEXT,
    Address2 TEXT,
    Address3 TEXT,
    Address4 TEXT,
    Country TEXT,
    State TEXT,
    TypeOfDealer TEXT,
    GSTIN TEXT,
    Email TEXT,
    MobileNo TEXT,
    BankName TEXT,
    AlterID INTEGER,
    GUID TEXT UNIQUE,
    PanNo TEXT,
    L1 REAL,
    L2 REAL,
    L3 REAL,
    L4 REAL,
    L5 REAL
);


selectAll:
SELECT * FROM LedgerMaster ORDER BY Name;

selectNameFromGuid:
SELECT Name
 FROM LedgerMaster
 WHERE GUID = ?;