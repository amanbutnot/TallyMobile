-- LedgerGroupMaster.sq

CREATE TABLE LedgerGroupMaster (
    Code INTEGER PRIMARY KEY AUTOINCREMENT,
    Name TEXT,
    Alias TEXT,
    GroupName TEXT,
    GroupCode TEXT NOT NULL,
    AlterID INTEGER,
    GUID TEXT UNIQUE
);

selectAll:
SELECT * FROM LedgerGroupMaster WHERE (:filterGroup = 0 OR LedgerGroupMaster.GroupCode IN :groupCodes OR CAST(LedgerGroupMaster.GUID AS INTEGER) IN :groupCodes) ORDER BY Name;
simpleSelectAll:
SELECT * FROM LedgerGroupMaster ORDER BY Name;

getChildrenByGroupCode:
SELECT * FROM LedgerGroupMaster WHERE GroupCode IN ? AND GUID NOT IN ?;
getChildrenByGroupName:
SELECT * FROM LedgerGroupMaster WHERE GroupName IN ? AND GUID NOT IN ?;

getByGroupCodes:
SELECT * FROM LedgerGroupMaster WHERE GroupCode IN ?;
getByGroupNames:
SELECT * FROM LedgerGroupMaster WHERE Name IN :GroupName AND GUID NOT IN :GUID;

getParentsByGuid:
SELECT * FROM LedgerGroupMaster WHERE GUID IN ?;