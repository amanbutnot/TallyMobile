CREATE TABLE Product_Param_Stock (
    MasterCode1 REAL,
    MasterCode2 REAL,
    Value1 REAL,
    Value2 REAL,
    Value3 REAL,
    BCN TEXT,
    C1 TEXT,
    C2 TEXT,
    C3 TEXT,
    C4 TEXT,
    C5 TEXT
);


insertProductParamStock:
INSERT OR IGNORE INTO Product_Param_Stock (
    MasterCode1,
    MasterCode2,
    Value1,
    Value2,
    Value3,
    BCN,
    C1,
    C2,
    C3,
    C4,
    C5
) VALUES (
    :masterCode1,
    :masterCode2,
    :value1,
    :value2,
    :value3,
    :bcn,
    :c1,
    :c2,
    :c3,
    :c4,
    :c5
);

getProductStockList:
SELECT
    pps.*,
    p.Name AS ProductName,
    g.Name AS GodownName,p.GroupName
FROM Product_Param_Stock pps
JOIN Products p
    ON p.GUID = pps.MasterCode1
JOIN GodownMaster g
    ON g.GUID = pps.MasterCode2
WHERE
    (:productGuid IS NULL OR p.GUID = :productGuid) AND
      (:filterParam1 = 0 OR C1 IN :configParam1) AND
     (:filterGroup = 0 OR p.GroupCode IN :groupCodes) AND
     (:filterExclude = 0 OR p.GUID NOT IN :excludeGuids) AND
    (:filterGodown = 0 OR pps.MasterCode2 IN :godownCodes)  ORDER BY ProductName,C1,C2,C3,C4,C5;
     -- (:filterGodown = 0 OR pps.MasterCode2 IN :godownCodes) ORDER BY ProductName,C1,C2,C3,C4,C5;

getProductParamStockList:
SELECT
    pps.MasterCode1,
    p.Name AS ProductName,
    sum(pps.Value1) AS mvalue1,
    sum(pps.Value2) AS mvalue2,p.GroupName
FROM Product_Param_Stock pps
JOIN Products p
    ON p.GUID = pps.MasterCode1
JOIN GodownMaster g
    ON g.GUID = pps.MasterCode2
WHERE
    (:productGuid IS NULL OR p.GUID = :productGuid) AND   (:filterParam1 = 0 OR C1 IN :configParam1) AND     (:filterGroup = 0 OR p.GroupCode IN :groupCodes) AND
                                                                                                              (:filterExclude = 0 OR p.GUID NOT IN :excludeGuids) AND
                                                                                                               (:filterGodown = 0 OR pps.MasterCode2 IN :godownCodes)
        GROUP BY pps.MasterCode1 ORDER BY ProductName;
