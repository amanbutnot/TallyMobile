CREATE TABLE CONFIG_MASTER (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    CONFIG_TYPE INTEGER NOT NULL,
    SRNO INTEGER NOT NULL,
    C1 TEXT,
    C2 TEXT,
    C3 TEXT,
    C4 TEXT,
    C5 TEXT,
    C6 TEXT,
    C7 TEXT,
    C8 TEXT,
    C9 TEXT,
    C10 TEXT
);

selectConfigMasterC1ByType:
SELECT C1 FROM CONFIG_MASTER WHERE CONFIG_TYPE = :configType ORDER BY SRNO;
