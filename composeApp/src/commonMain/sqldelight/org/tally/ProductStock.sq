CREATE TABLE ProductStock (
    MasterCode1 TEXT,
    MasterCode2 TEXT,
    Value1 TEXT,
    Value2 TEXT,
    Value3 TEXT,
    GUID TEXT NOT NULL UNIQUE
);


-- =====================================================
-- UNIFIED QUERY WITH OPTIONAL FILTERS
-- =====================================================

getProductStockItemList:
SELECT
    pps.*,
    p.Name AS ProductName,
    p.UnitName,
    g.Name AS GodownName
FROM ProductStock pps
JOIN Products p ON p.GUID = pps.MasterCode1
JOIN GodownMaster g ON g.GUID = pps.MasterCode2
WHERE
    (:filterGroup = 0 OR p.GroupCode IN :groupCodes)
    AND (:filterExclude = 0 OR p.GUID NOT IN :excludeGuids)
    AND (:filterGodown = 0 OR pps.MasterCode2 IN :godownCodes);