CREATE TABLE Vouchers_Ledgers (
    GUID TEXT UNIQUE,
    VCH_GUID TEXT,
    VchType TEXT,
    VchName TEXT,
    DATE TEXT,
    VOUCHERNUMBER TEXT,
    SRNO INTEGER,
    CM1 TEXT,
    CM2 TEXT,
    D1 REAL,
    D2 REAL,
    D3 REAL,
    E1 TEXT,
    E2 TEXT,
    E3 TEXT
);


trialBalanceList:
SELECT
    CM1,
    SUM(D1) AS ClsnBal
FROM Vouchers_Ledgers
GROUP BY CM1
ORDER BY CM1;


ledgerReportList:
SELECT
  VL.*,
  (
    SELECT Tb1.CM1
    FROM Vouchers_Ledgers AS Tb1
    WHERE Tb1.VCH_GUID = VL.VCH_GUID
      AND Tb1.SRNO != VL.SRNO
    LIMIT 1
  ) AS AccountName
FROM Vouchers_Ledgers AS VL
WHERE VL.CM1 = ?
  AND VL.DATE >= ?
  AND VL.DATE <= ?
ORDER BY VL.DATE, VL.VOUCHERNUMBER;
