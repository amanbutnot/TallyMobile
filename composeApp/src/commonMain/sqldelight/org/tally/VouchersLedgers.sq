CREATE TABLE Vouchers_Ledgers (
    GUID TEXT UNIQUE,
    VCH_GUID TEXT,
    VchType TEXT,
    VchName TEXT,
    DATE TEXT,
    VOUCHERNUMBER TEXT,
    SRNO INTEGER,
    CM1 TEXT,
    CM2 TEXT,
    D1 REAL,
    D2 REAL,
    D3 REAL,
    E1 TEXT,
    E2 TEXT,
    FinYr TEXT,
    E3 TEXT
);


trialBalanceList:
SELECT
    CM1,
    SUM(D1) AS ClsnBal
FROM Vouchers_Ledgers WHERE CM1 IN (
                                                    SELECT Name
                                                    FROM LedgerMaster
                                                    WHERE (:groupFilter = 0 OR GroupCode IN ?)
                                                      AND (:excludeFilter = 0 OR GUID NOT IN ?)
                                                )
                                                --for financial year
                                                -- AND  ( DATE>=:startDate OR  (  VchType='Opening' AND DATE=:endDate)  )
GROUP BY CM1
ORDER BY CM1;

getLedgerBalance:
SELECT
    CM1,
    SUM(D1) AS ClsnBal
FROM Vouchers_Ledgers WHERE CM1 IN (
                                                    SELECT Name
                                                    FROM LedgerMaster
                                                    WHERE (:groupFilter = 0 OR GroupCode IN ?)
                                                      AND (:excludeFilter = 0 OR GUID NOT IN ?)
                                                ) AND CM1 = :ledgername
                                                --for financial year
                                                -- AND  ( DATE>=:startDate OR  (  VchType='Opening' AND DATE=:endDate)  )
GROUP BY CM1
ORDER BY CM1;


ledgerReportList:
SELECT
  VL.*,
  (
    SELECT Tb1.CM1
    FROM Vouchers_Ledgers AS Tb1
    WHERE Tb1.VCH_GUID = VL.VCH_GUID
      AND Tb1.SRNO != VL.SRNO
    LIMIT 1
  ) AS AccountName
FROM Vouchers_Ledgers AS VL
WHERE VL.CM1 = ?
  AND VL.DATE >= ?
  AND VL.DATE <= ?
ORDER BY VL.DATE, VL.VOUCHERNUMBER;


ledgerOpeningBalance:
SELECT Sum(D1) AS OpeningBal  FROM Vouchers_Ledgers WHERE CM1=? AND DATE<?;

ledgerReportItemList:
SELECT SRNO,CM1 AS LedgerName, D2 AS CreditAmt,D3 AS DebitAmt FROM Vouchers_Ledgers WHERE VCH_GUID  =? ORDER BY SRNO;

registerReportList:
SELECT DATE,
VchName,VOUCHERNUMBER,D1,VCH_GUID,CM1
FROM Vouchers_Ledgers
WHERE VchType=? AND (:filterCm3 = 0 OR Vouchers_Ledgers.CM2 IN :cm3) AND CM1 IN (
                        SELECT Name
                        FROM LedgerMaster
                        WHERE (:groupFilter = 0 OR GroupCode IN ?)
                          AND (:excludeFilter = 0 OR GUID NOT IN ?)
                    )
  AND SRNO=:srNo
  AND DATE>=?
  AND DATE<=?
ORDER BY DATE ;
