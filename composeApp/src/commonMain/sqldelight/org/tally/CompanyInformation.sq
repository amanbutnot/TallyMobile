
CREATE TABLE CompanyInformation (
    T1 TEXT,
    T2 TEXT,
    T3 TEXT,
    T4 TEXT,
    T5 TEXT,
    T6 TEXT,
    T7 TEXT,
    T8 TEXT,
    T9 TEXT,
    T10 TEXT,
    D1 REAL,
    D2 REAL,
    D3 REAL,
    D4 REAL,
    D5 REAL,
    D6 REAL,
    D7 REAL,
    D8 REAL,
    D9 REAL,
    D10 REAL,
    D11 REAL,
    D12 REAL,
    D13 REAL,
    D14 REAL,
    D15 REAL,
    D16 REAL,
    D17 REAL,
    D18 REAL,
    D19 REAL,
    D20 REAL,
    D21 REAL,
    D22 REAL,
    D23 REAL,
    D24 REAL,
    D25 REAL,
    D26 REAL,
    D27 REAL,
    D28 REAL,
    D29 REAL,
    D30 REAL,
    D31 REAL,
    D32 REAL,
    D33 REAL,
    D34 REAL,
    D35 REAL,
    D36 REAL,
    D37 REAL,
    D38 REAL,
    D39 REAL,
    D40 REAL,
    GUID TEXT UNIQUE
);

selectAll:
SELECT * FROM CompanyInformation;

startDateQuery:
SELECT T2 FROM CompanyInformation;

companyNameQuery:
SELECT T1 FROM CompanyInformation;

dashboardReportData:
SELECT
    1 AS RecType,
    SUM(D1) * -1 AS PenAmt,
    'Receivable' AS RepType
FROM Vouchers_BILLALLOCATIONS
WHERE BILLID IN (
    SELECT BILLID
    FROM Vouchers_BILLALLOCATIONS
    WHERE CM2 IN ('New Ref', 'Advance')
      AND D1 < 0
)
AND DATE >= ?1
AND DATE <= ?2

UNION ALL

SELECT
    2 AS RecType,
    SUM(D1) AS PenAmt,
    'Payable' AS RepType
FROM Vouchers_BILLALLOCATIONS
WHERE BILLID IN (
    SELECT BILLID
    FROM Vouchers_BILLALLOCATIONS
    WHERE CM2 IN ('New Ref', 'Advance')
      AND D1 > 0
)
AND DATE >= ?1
AND DATE <= ?2

UNION ALL

SELECT
    3 AS RecType,
    SUM(D1) * -1 AS Amt,
    'SalesRegister' AS RepType
FROM Vouchers_Ledgers
WHERE VchType = 'Sales'
  AND SRNO = 1
  AND DATE >= ?1
  AND DATE <= ?2

UNION ALL

SELECT
    4 AS RecType,
    SUM(D1) AS Amt,
    'PurchaseRegister' AS RepType
FROM Vouchers_Ledgers
WHERE VchType = 'Purchase'
  AND SRNO = 1
  AND DATE >= ?1
  AND DATE <= ?2

UNION ALL

SELECT
    5 AS RecType,
    SUM(D1) AS Amt,
    'RcptRegister' AS RepType
FROM Vouchers_Ledgers
WHERE VchType = 'Receipt'
  AND SRNO = 1
  AND DATE >= ?1
  AND DATE <= ?2

UNION ALL

SELECT
    6 AS RecType,
    SUM(D1) * -1 AS Amt,
    'PymntRegister' AS RepType
FROM Vouchers_Ledgers
WHERE VchType = 'Payment'
  AND SRNO= 1
  AND DATE >= ?1
  AND DATE <= ?2;

getCompanyInformation:
SELECT T1,T2,T3,T4,T5,T6,T7,T8,T9,D3,D4 FROM CompanyInformation;