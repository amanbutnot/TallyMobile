CREATE TABLE IF NOT EXISTS COUPON_MASTER (
    ID INTEGER NOT NULL PRIMARY KEY,
    CODE TEXT NOT NULL,
    MFG_DATE TEXT,
    EXP_DATE TEXT,
    DISC_TYPE TEXT,
    DISC_PER REAL NOT NULL DEFAULT 0,
    BILL_VAL REAL NOT NULL DEFAULT 0,
    TOT_COUNT INTEGER NOT NULL DEFAULT 0,
    ISU_COUNT INTEGER NOT NULL DEFAULT 0,
    USE_COUNT INTEGER NOT NULL DEFAULT 0,
    STATUS TEXT,
    C1 TEXT,
    C2 TEXT,
    C3 TEXT
);

selectAll:
SELECT ID, CODE, DISC_TYPE, DISC_PER, BILL_VAL, MFG_DATE, EXP_DATE, STATUS FROM COUPON_MASTER WHERE UPPER(STATUS) = 'ACTIVE';

selectByCode:
SELECT * FROM COUPON_MASTER WHERE CODE = :code AND UPPER(STATUS) = 'ACTIVE';

insertCoupon:
INSERT OR REPLACE INTO COUPON_MASTER(ID, CODE, MFG_DATE, EXP_DATE, DISC_TYPE, DISC_PER, BILL_VAL, TOT_COUNT, ISU_COUNT, USE_COUNT, STATUS, C1, C2, C3)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
