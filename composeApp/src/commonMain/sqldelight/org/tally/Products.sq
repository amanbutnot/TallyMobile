-- Products.sq

CREATE TABLE Products (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Name TEXT,
    Alias TEXT,
    PrintName TEXT,
    GroupName TEXT,
    GroupCode REAL,
    UnitName TEXT,
    UnitCode REAL,
    OpStk REAL,
    OpStkValue REAL,
    TaxCategory TEXT,
    TaxCategoryCode REAL,
    HSN TEXT,
    SalesPrice REAL,
    PurcPrice REAL,
    MRP REAL,
    MinSalesPrice REAL,
    SelfValPrice REAL,
    SaleDisc REAL,
    PurcDisc REAL,
    Vendor TEXT,
    VendorCode REAL,
    MaintainStock REAL,
    ALTERID TEXT,
    GUID TEXT UNIQUE
);

-- ledger.sq


 getItemByName:
SELECT *
FROM Products
WHERE GUID IN (
    SELECT MasterCode1
    FROM Product_Param_Stock
    WHERE BCN = :itemName
      COLLATE NOCASE
)
UNION ALL
SELECT *
FROM Products
WHERE Name= :itemName AND (:filterGroup = 0 OR Products.GroupCode IN :groupCodes)
  COLLATE NOCASE;


-- All filters
selectAllFilterAGRP:
SELECT * FROM Products
WHERE GroupCode IN ? AND GUID NOT IN ?
ORDER BY Name;

-- Only GroupCode filter
selectByGroupCode:
SELECT * FROM Products
WHERE GroupCode IN ?
ORDER BY Name;

-- Only GUID exclusion
selectExcludingGuid:
SELECT * FROM Products
WHERE GUID NOT IN ?
ORDER BY Name;

-- No filters
selectAll:
SELECT * FROM Products
ORDER BY Name;

-- Distributor
productCategoriesForDis:
SELECT Name,GUID FROM ProductGroupMaster ORDER BY Name;

getProductsForDis:
SELECT
    GUID AS product_id,
    GUID AS hospital_id,
    Name AS product_name,
    GroupCode AS category_id,
    UnitCode AS unit_id,
    SalesPrice AS sales_price,
    MRP,
    PurcPrice AS purchase_price,
    SaleDisc AS discount,

COALESCE(
    (
        SELECT IGST
        FROM Tax_Category_Mast
        WHERE Tax_Category_Mast.GUID = Products.TaxCategoryCode
          AND AppDate <= '2025-04-01'
        ORDER BY AppDate DESC
        LIMIT 1
    ),
    0
) AS gst_tax_percentage,

    Name AS product_description,
    '' AS created_at,
    '' AS updated_at,

    ROUND(
        CASE
            WHEN IFNULL(SaleDisc, 0) = 0 THEN SalesPrice
            ELSE SalesPrice - (SalesPrice * SaleDisc / 100.0)
        END,
        2
    ) AS discounted_price

FROM Products
WHERE (:groupCode IS NULL OR GroupCode = :groupCode)
ORDER BY Name;
