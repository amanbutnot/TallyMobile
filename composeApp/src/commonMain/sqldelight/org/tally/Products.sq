-- Products.sq

CREATE TABLE Products (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Name TEXT,
    Alias TEXT,
    PrintName TEXT,
    GroupName TEXT,
    GroupCode REAL,
    UnitName TEXT,
    UnitCode REAL,
    OpStk REAL,
    OpStkValue REAL,
    TaxCategory TEXT,
    TaxCategoryCode REAL,
    HSN TEXT,
    SalesPrice REAL,
    PurcPrice REAL,
    MRP REAL,
    MinSalesPrice REAL,
    SelfValPrice REAL,
    SaleDisc REAL,
    PurcDisc REAL,
    Vendor TEXT,
    VendorCode REAL,
    MaintainStock REAL,
    E4 REAL,
    E5 REAL,
    ALTERID TEXT,
    GUID TEXT UNIQUE,N1 REAL,AltUnit TEXT,ConFactor REAL,ConType REAL,L6 REAL,
    PRICE1 REAL,
    PRICE2 REAL,
    PRICE3 REAL,
    PRICE4 REAL,
    PRICE5 REAL
);

CREATE TABLE IF NOT EXISTS ProductMultyPricing (
    GUID TEXT PRIMARY KEY,
    Price1 REAL,
    Price2 REAL,
    Price3 REAL,
    Price4 REAL,
    Price5 REAL
);

existingItems:
SELECT GUID FROM Products WHERE (Name = :name1 OR Alias = :alias1) OR (Name = :name2 OR Alias = :alias2);


insertItem:
INSERT OR IGNORE INTO Products (
    Name,
    Alias,
    PrintName,
    GroupName,
    GroupCode,
    UnitName,
    UnitCode,
    OpStk,
    OpStkValue,
    TaxCategory,
    TaxCategoryCode,
    SalesPrice,
    PurcPrice,
    MRP,
    MinSalesPrice,
    SelfValPrice,
    SaleDisc,
    PurcDisc,
    GUID,
    AltUnit,
    ConFactor,
    ConType
) VALUES (
    :name,
    :alias,
    :printName,
    :parentGroup,
    :parentGroupGuid,
    :mainUnit,
    :mainUnitGuid,
    :opQty,
    :opAmount,
    :taxCategoryName,
    :taxCategoryGuid,
    :salePrice,
    :purchPrice,
    :mrp,
    :minSalePrice,
    :selfValPrice,
    :saleDiscount,
    :purchDiscount,
    :product_guid,
    :altUnit,
    :conFactor,
    :conType
);

 getItemByName:
SELECT *
FROM Products
WHERE GUID IN (
    SELECT MasterCode1
    FROM Product_Param_Stock
    WHERE BCN = :itemName
      COLLATE NOCASE
)
UNION ALL
SELECT *
FROM Products
WHERE Name= :itemName AND (:filterGroup = 0 OR Products.GroupCode IN :groupCodes)
  COLLATE NOCASE;


selectAllFilterAGRP:
SELECT * FROM Products
WHERE GroupCode IN ?
  AND GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
ORDER BY Name;

selectByGroupCode:
SELECT * FROM Products
WHERE GroupCode IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
ORDER BY Name;

selectExcludingGuid:
SELECT * FROM Products
WHERE GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
ORDER BY Name;

selectAll:
SELECT * FROM Products
WHERE (:applyN1Filter = 0 OR N1 > 0)
ORDER BY Name;

-- Distributor
productCategoriesForDis:
SELECT Name,GUID FROM ProductGroupMaster WHERE (:filterGroup = 0 OR ProductGroupMaster.GroupCode IN :groupCodes) ORDER BY Name;

getProductsForDis:
SELECT
    product_id,
    hospital_id,
    product_name,
    category_id,
    unit_id,
    effective_sales_price AS sales_price,
    MRP,
    purchase_price,
    discount,
    gst_tax_percentage,
    product_description,
    created_at,
    updated_at,
    ROUND(
        CASE
            WHEN IFNULL(discount, 0) = 0 THEN effective_sales_price
            ELSE effective_sales_price - (effective_sales_price * discount / 100.0)
        END,
        2
    ) AS discounted_price,
    main_unit,
    alt_unit,
    con_factor,
    con_type
FROM (
    SELECT
        Products.GUID AS product_id,
        Products.GUID AS hospital_id,
        Products.Name AS product_name,
        Products.GroupCode AS category_id,
        Products.UnitCode AS unit_id,
        COALESCE(
            CASE
                WHEN :changePrice = 101.0 AND IFNULL(PMP.Price1, 0.0) != 0.0 THEN PMP.Price1
                WHEN :changePrice = 102.0 AND IFNULL(PMP.Price2, 0.0) != 0.0 THEN PMP.Price2
                WHEN :changePrice = 103.0 AND IFNULL(PMP.Price3, 0.0) != 0.0 THEN PMP.Price3
                WHEN :changePrice = 104.0 AND IFNULL(PMP.Price4, 0.0) != 0.0 THEN PMP.Price4
                WHEN :changePrice = 105.0 AND IFNULL(PMP.Price5, 0.0) != 0.0 THEN PMP.Price5
                ELSE NULL
            END,
            Products.SalesPrice
        ) AS effective_sales_price,
        Products.MRP,
        Products.PurcPrice AS purchase_price,
        Products.SaleDisc AS discount,
        COALESCE(
            (
                SELECT IGST
                FROM Tax_Category_Mast
                WHERE Tax_Category_Mast.GUID = Products.TaxCategoryCode
                  AND AppDate <= '2025-04-01'
                ORDER BY AppDate DESC
                LIMIT 1
            ),
            0
        ) AS gst_tax_percentage,
        Products.Name AS product_description,
        '' AS created_at,
        '' AS updated_at,
        Products.UnitName AS main_unit,
        Products.AltUnit AS alt_unit,
        Products.ConFactor AS con_factor,
        Products.ConType AS con_type,
        Products.E4,
        Products.E5,
        Products.GroupCode,
        Products.GUID
    FROM Products
    LEFT JOIN ProductMultyPricing PMP ON CAST(Products.GUID AS REAL) = CAST(PMP.GUID AS REAL)
) AS Sub
WHERE (:filterGroup = 0 OR GroupCode IN :groupCodes) AND (:productCode IS NULL OR GroupCode = :productCode) AND ( E4 <> -1.0   OR  E4 IS NULL) AND   (E5<>-1.0 OR  E5 IS NULL )
ORDER BY product_name;

getProductsByGuidsForDis:
SELECT
    product_id,
    hospital_id,
    product_name,
    category_id,
    unit_id,
    effective_sales_price AS sales_price,
    MRP,
    purchase_price,
    discount,
    gst_tax_percentage,
