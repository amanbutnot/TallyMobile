-- Products.sq

CREATE TABLE Products (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Name TEXT,
    Alias TEXT,
    PrintName TEXT,
    GroupName TEXT,
    GroupCode REAL,
    UnitName TEXT,
    UnitCode REAL,
    OpStk REAL,
    OpStkValue REAL,
    TaxCategory TEXT,
    TaxCategoryCode REAL,
    HSN TEXT,
    SalesPrice REAL,
    PurcPrice REAL,
    MRP REAL,
    MinSalesPrice REAL,
    SelfValPrice REAL,
    SaleDisc REAL,
    PurcDisc REAL,
    Vendor TEXT,
    VendorCode REAL,
    MaintainStock REAL,
    ALTERID TEXT,
    GUID TEXT UNIQUE
);

-- ledger.sq

-- All filters
selectAllFilterAGRP:
SELECT * FROM Products
WHERE GroupCode IN ? AND GUID NOT IN ?
ORDER BY Name;

-- Only GroupCode filter
selectByGroupCode:
SELECT * FROM Products
WHERE GroupCode IN ?
ORDER BY Name;

-- Only GUID exclusion
selectExcludingGuid:
SELECT * FROM Products
WHERE GUID NOT IN ?
ORDER BY Name;

-- No filters
selectAll:
SELECT * FROM Products
ORDER BY Name;
