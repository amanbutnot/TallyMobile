-- Products.sq

CREATE TABLE Products (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Name TEXT,
    Alias TEXT,
    PrintName TEXT,
    GroupName TEXT,
    GroupCode REAL,
    UnitName TEXT,
    UnitCode REAL,
    OpStk REAL,
    OpStkValue REAL,
    TaxCategory TEXT,
    TaxCategoryCode REAL,
    HSN TEXT,
    SalesPrice REAL,
    PurcPrice REAL,
    MRP REAL,
    MinSalesPrice REAL,
    SelfValPrice REAL,
    SaleDisc REAL,
    PurcDisc REAL,
    Vendor TEXT,
    VendorCode REAL,
    MaintainStock REAL,
    E4 REAL,
    E5 REAL,
    ALTERID TEXT,
    GUID TEXT UNIQUE,N1 REAL,AltUnit TEXT,ConFactor REAL,ConType REAL,L6 REAL,
    PRICE1 REAL,
    PRICE2 REAL,
    PRICE3 REAL,
    PRICE4 REAL,
    PRICE5 REAL
);

existingItems:
SELECT GUID FROM Products WHERE (Name = :name1 OR Alias = :alias1) OR (Name = :name2 OR Alias = :alias2);


insertItem:
INSERT OR IGNORE INTO Products (
    Name,
    Alias,
    PrintName,
    GroupName,
    GroupCode,
    UnitName,
    UnitCode,
    OpStk,
    OpStkValue,
    TaxCategory,
    TaxCategoryCode,
    SalesPrice,
    PurcPrice,
    MRP,
    MinSalesPrice,
    SelfValPrice,
    SaleDisc,
    PurcDisc,
    GUID,
    AltUnit,
    ConFactor,
    ConType
) VALUES (
    :name,
    :alias,
    :printName,
    :parentGroup,
    :parentGroupGuid,
    :mainUnit,
    :mainUnitGuid,
    :opQty,
    :opAmount,
    :taxCategoryName,
    :taxCategoryGuid,
    :salePrice,
    :purchPrice,
    :mrp,
    :minSalePrice,
    :selfValPrice,
    :saleDiscount,
    :purchDiscount,
    :product_guid,
    :altUnit,
    :conFactor,
    :conType
);

 getItemByName:
SELECT *
FROM Products
WHERE GUID IN (
    SELECT MasterCode1
    FROM Product_Param_Stock
    WHERE BCN = :itemName
      COLLATE NOCASE
)
UNION ALL
SELECT *
FROM Products
WHERE Name= :itemName AND (:filterGroup = 0 OR Products.GroupCode IN :groupCodes)
  COLLATE NOCASE;


selectAllFilterAGRP:
SELECT * FROM Products
WHERE GroupCode IN ?
  AND GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
ORDER BY Name;

selectByGroupCode:
SELECT * FROM Products
WHERE GroupCode IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
ORDER BY Name;

selectExcludingGuid:
SELECT * FROM Products
WHERE GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
ORDER BY Name;

selectAll:
SELECT * FROM Products
WHERE (:applyN1Filter = 0 OR N1 > 0)
ORDER BY Name;

-- Distributor
productCategoriesForDis:
SELECT Name,GUID FROM ProductGroupMaster WHERE (:filterGroup = 0 OR ProductGroupMaster.GroupCode IN :groupCodes) ORDER BY Name;

getProductsForDis:
SELECT
    GUID AS product_id,
    GUID AS hospital_id,
    Name AS product_name,
    GroupCode AS category_id,
    UnitCode AS unit_id,
    SalesPrice AS sales_price,
    MRP,
    PurcPrice AS purchase_price,
    SaleDisc AS discount,

COALESCE(
    (
        SELECT IGST
        FROM Tax_Category_Mast
        WHERE Tax_Category_Mast.GUID = Products.TaxCategoryCode
          AND AppDate <= '2025-04-01'
        ORDER BY AppDate DESC
        LIMIT 1
    ),
    0
) AS gst_tax_percentage,

    Name AS product_description,
    '' AS created_at,
    '' AS updated_at,

    ROUND(
        CASE
            WHEN IFNULL(SaleDisc, 0) = 0 THEN SalesPrice
            ELSE SalesPrice - (SalesPrice * SaleDisc / 100.0)
        END,
        2
    ) AS discounted_price,
    UnitName AS main_unit,
    AltUnit AS alt_unit,
    ConFactor AS con_factor,
    ConType AS con_type

FROM Products
WHERE (:filterGroup = 0 OR Products.GroupCode IN :groupCodes) AND (:productCode IS NULL OR Products.GroupCode = :productCode) AND ( Products.E4 <> -1.0   OR  Products.E4 IS NULL) AND   (Products.E5<>-1.0 OR  Products.E5 IS NULL )
ORDER BY Name;

getProductsByGuidsForDis:
SELECT
    GUID AS product_id,
    GUID AS hospital_id,
    Name AS product_name,
    GroupCode AS category_id,
    UnitCode AS unit_id,
    SalesPrice AS sales_price,
    MRP,
    PurcPrice AS purchase_price,
    SaleDisc AS discount,

COALESCE(
    (
        SELECT IGST
        FROM Tax_Category_Mast
        WHERE Tax_Category_Mast.GUID = Products.TaxCategoryCode
          AND AppDate <= '2025-04-01'
        ORDER BY AppDate DESC
        LIMIT 1
    ),
    0
) AS gst_tax_percentage,

    Name AS product_description,
    '' AS created_at,
    '' AS updated_at,

    ROUND(
        CASE
            WHEN IFNULL(SaleDisc, 0) = 0 THEN SalesPrice
            ELSE SalesPrice - (SalesPrice * SaleDisc / 100.0)
        END,
        2
    ) AS discounted_price,
    UnitName AS main_unit,
    AltUnit AS alt_unit,
    ConFactor AS con_factor,
    ConType AS con_type

FROM Products
WHERE GUID IN :guids AND ( Products.E4 <> -1.0   OR  Products.E4 IS NULL) AND   (Products.E5<>-1.0 OR  Products.E5 IS NULL )
ORDER BY Name;

getProductsByCategoryMapping:
SELECT
    GUID AS product_id,
    GUID AS hospital_id,
    Name AS product_name,
    GroupCode AS category_id,
    UnitCode AS unit_id,
    SalesPrice AS sales_price,
    MRP,
    PurcPrice AS purchase_price,
    SaleDisc AS discount,

COALESCE(
    (
        SELECT IGST
        FROM Tax_Category_Mast
        WHERE Tax_Category_Mast.GUID = Products.TaxCategoryCode
          AND AppDate <= '2025-04-01'
        ORDER BY AppDate DESC
        LIMIT 1
    ),
    0
) AS gst_tax_percentage,

    Name AS product_description,
    '' AS created_at,
    '' AS updated_at,

    ROUND(
        CASE
            WHEN IFNULL(SaleDisc, 0) = 0 THEN SalesPrice
            ELSE SalesPrice - (SalesPrice * SaleDisc / 100.0)
        END,
        2
    ) AS discounted_price,
    UnitName AS main_unit,
    AltUnit AS alt_unit,
    ConFactor AS con_factor,
    ConType AS con_type

FROM Products
WHERE GUID IN (
    SELECT CAST(CAST(ProductCode AS INTEGER) AS TEXT) FROM Product_Category
    WHERE GroupCode = :groupCode
    AND (:catCode IS NULL OR CatCode = :catCode)
)
AND ( Products.E4 <> -1.0   OR  Products.E4 IS NULL) AND (Products.E5<>-1.0 OR  Products.E5 IS NULL )
ORDER BY Name;



-- FOR SALE PURCHASE CONFIGURATIONS


selectAllFilterAGRPConfig:
SELECT
    Products.ID,
    Products.Name,
    Products.Alias,
    Products.PrintName,
    Products.GroupName,
    Products.GroupCode,
    Products.UnitName,
    Products.UnitCode,
    Products.OpStk,
    Products.OpStkValue,
    Products.TaxCategory,
    Products.TaxCategoryCode,
    Products.HSN,
    Products.SalesPrice,
    Products.PurcPrice,
    Products.MRP,
    Products.MinSalesPrice,
    Products.SelfValPrice,
    Products.SaleDisc,
    Products.PurcDisc,
    Products.Vendor,
    Products.VendorCode,
    Products.MaintainStock,
    Products.ALTERID,
    Products.GUID,
    Products.N1,
    Products.AltUnit,
    Products.ConFactor,
    Products.ConType,
    CAST(COALESCE(PS.Value1, 0.0) AS REAL) AS McOpening
FROM Products
LEFT JOIN ProductStock PS
    ON PS.MasterCode1 = Products.GUID AND  PS.MasterCode2=:compConfigFilter
WHERE GroupCode IN ?
  AND Products.GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0) AND Products.E4 <> -1.0 AND Products.E5<>-1.0
ORDER BY Name;

