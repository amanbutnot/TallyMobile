        Products.E5,
        Products.GUID
    FROM Products
    LEFT JOIN ProductMultyPricing PMP ON CAST(Products.GUID AS REAL) = CAST(PMP.GUID AS REAL)
) AS Sub
WHERE GUID IN :guids AND ( E4 <> -1.0   OR  E4 IS NULL) AND   (E5<>-1.0 OR  E5 IS NULL )
ORDER BY product_name;

getProductsByCategoryMapping:
SELECT
    product_id,
    hospital_id,
    product_name,
    category_id,
    unit_id,
    effective_sales_price AS sales_price,
    MRP,
    purchase_price,
    discount,
    gst_tax_percentage,
    product_description,
    created_at,
    updated_at,
    ROUND(
        CASE
            WHEN IFNULL(discount, 0) = 0 THEN effective_sales_price
            ELSE effective_sales_price - (effective_sales_price * discount / 100.0)
        END,
        2
    ) AS discounted_price,
    main_unit,
    alt_unit,
    con_factor,
    con_type
FROM (
    SELECT
        Products.GUID AS product_id,
        Products.GUID AS hospital_id,
        Products.Name AS product_name,
        Products.GroupCode AS category_id,
        Products.UnitCode AS unit_id,
        COALESCE(
            CASE
                WHEN :changePrice = 101.0 AND IFNULL(PMP.Price1, 0.0) != 0.0 THEN PMP.Price1
                WHEN :changePrice = 102.0 AND IFNULL(PMP.Price2, 0.0) != 0.0 THEN PMP.Price2
                WHEN :changePrice = 103.0 AND IFNULL(PMP.Price3, 0.0) != 0.0 THEN PMP.Price3
                WHEN :changePrice = 104.0 AND IFNULL(PMP.Price4, 0.0) != 0.0 THEN PMP.Price4
                WHEN :changePrice = 105.0 AND IFNULL(PMP.Price5, 0.0) != 0.0 THEN PMP.Price5
                ELSE NULL
            END,
            Products.SalesPrice
        ) AS effective_sales_price,
        Products.MRP,
        Products.PurcPrice AS purchase_price,
        Products.SaleDisc AS discount,
        COALESCE(
            (
                SELECT IGST
                FROM Tax_Category_Mast
                WHERE Tax_Category_Mast.GUID = Products.TaxCategoryCode
                  AND AppDate <= '2025-04-01'
                ORDER BY AppDate DESC
                LIMIT 1
            ),
            0
        ) AS gst_tax_percentage,
        Products.Name AS product_description,
        '' AS created_at,
        '' AS updated_at,
        Products.UnitName AS main_unit,
        Products.AltUnit AS alt_unit,
        Products.ConFactor AS con_factor,
        Products.ConType AS con_type,
        Products.E4,
        Products.E5,
        Products.GUID
    FROM Products
    LEFT JOIN ProductMultyPricing PMP ON CAST(Products.GUID AS REAL) = CAST(PMP.GUID AS REAL)
) AS Sub
WHERE GUID IN (
    SELECT CAST(CAST(ProductCode AS INTEGER) AS TEXT) FROM Product_Category
    WHERE GroupCode = :groupCode
    AND (:catCode IS NULL OR CatCode = :catCode)
)
AND ( E4 <> -1.0   OR  E4 IS NULL) AND (E5<>-1.0 OR  E5 IS NULL )
ORDER BY product_name;



-- FOR SALE PURCHASE CONFIGURATIONS


selectAllFilterAGRPConfig:
SELECT
    Products.ID,
    Products.Name,
    Products.Alias,
    Products.PrintName,
    Products.GroupName,
    Products.GroupCode,
    Products.UnitName,
    Products.UnitCode,
    Products.OpStk,
    Products.OpStkValue,
    Products.TaxCategory,
    Products.TaxCategoryCode,
    Products.HSN,
    Products.SalesPrice,
    Products.PurcPrice,
    Products.MRP,
    Products.MinSalesPrice,
    Products.SelfValPrice,
    Products.SaleDisc,
    Products.PurcDisc,
    Products.Vendor,
    Products.VendorCode,
    Products.MaintainStock,
    Products.ALTERID,
    Products.GUID,
    Products.N1,
    Products.AltUnit,
    Products.ConFactor,
    Products.ConType,
    CAST(COALESCE(PS.Value1, 0.0) AS REAL) AS McOpening
FROM Products
LEFT JOIN ProductStock PS
    ON PS.MasterCode1 = Products.GUID AND  PS.MasterCode2=:compConfigFilter
WHERE GroupCode IN ?
  AND Products.GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0) AND Products.E4 <> -1.0 AND Products.E5<>-1.0
ORDER BY Name;

