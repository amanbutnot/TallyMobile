WHERE GUID IN (
    SELECT CAST(CAST(ProductCode AS INTEGER) AS TEXT) FROM Product_Category
    WHERE GroupCode = :groupCode
    AND (:catCode IS NULL OR CatCode = :catCode)
)
AND ( E4 <> -1.0   OR  E4 IS NULL)
ORDER BY product_name;



-- FOR SALE PURCHASE CONFIGURATIONS


selectAllFilterAGRPConfig:
SELECT
    Products.ID,
    Products.Name,
    Products.Alias,
    Products.PrintName,
    Products.GroupName,
    Products.GroupCode,
    Products.UnitName,
    Products.UnitCode,
    Products.OpStk,
    Products.OpStkValue,
    Products.TaxCategory,
    Products.TaxCategoryCode,
    Products.HSN,
    Products.SalesPrice,
    Products.PurcPrice,
    Products.MRP,
    Products.MinSalesPrice,
    Products.SelfValPrice,
    Products.SaleDisc,
    Products.PurcDisc,
    Products.Vendor,
    Products.VendorCode,
    Products.MaintainStock,
    Products.ALTERID,
    Products.GUID,
    Products.N1,
    Products.AltUnit,
    Products.ConFactor,
    Products.ConType,
    Products.SalesPriceAlt,
    Products.PurcPriceAlt,
    CAST(COALESCE(PS.Value1, 0.0) AS REAL) AS McOpening,
    Products.E4,
    Products.E5
FROM Products
LEFT JOIN ProductStock PS
    ON PS.MasterCode1 = Products.GUID AND  PS.MasterCode2=:compConfigFilter
WHERE GroupCode IN ?
  AND Products.GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
  AND CAST(COALESCE(Products.E4, 0.0) AS REAL) <> -1.0
  AND CAST(COALESCE(Products.E5, 0.0) AS REAL) <> -1.0
ORDER BY Name;

