-- if e5 -1 (out of stock)

getBrandsForDis:
SELECT DISTINCT OFMaster.Name
FROM Products
JOIN OFMaster ON CAST(Products.OF8 AS REAL) = OFMaster.Code
WHERE (:filterGroup = 0 OR Products.GroupCode IN :groupCodes)
  AND (:productCode IS NULL OR Products.GroupCode = :productCode)
  AND ( Products.E4 <> -1.0 OR Products.E4 IS NULL)
  AND Products.OF8 IS NOT NULL AND Products.OF8 != ''
ORDER BY OFMaster.Name;
