-- Products.sq

CREATE TABLE Products (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Name TEXT,
    Alias TEXT,
    PrintName TEXT,
    GroupName TEXT,
    GroupCode REAL,
    UnitName TEXT,
    UnitCode REAL,
    OpStk REAL,
    OpStkValue REAL,
    TaxCategory TEXT,
    TaxCategoryCode REAL,
    HSN TEXT,
    SalesPrice REAL,
    PurcPrice REAL,
    MRP REAL,
    MinSalesPrice REAL,
    SelfValPrice REAL,
    SaleDisc REAL,
    PurcDisc REAL,
    Vendor TEXT,
    VendorCode REAL,
    MaintainStock REAL,
    E4 REAL,
    E5 REAL,
    ALTERID TEXT,
    GUID TEXT UNIQUE,N1 REAL,AltUnit TEXT,ConFactor REAL,ConType REAL,L6 REAL,
    SalesPriceAlt REAL,
    PurcPriceAlt REAL,
    PRICE1 REAL,
    PRICE2 REAL,
    PRICE3 REAL,
    PRICE4 REAL,
    OF3 REAL,
    OF4 REAL,
    OF8 TEXT,
    OF9 REAL,
    OF10 REAL,
    PRICE5 REAL
);

CREATE TABLE IF NOT EXISTS ProductMultyPricing (
    GUID TEXT PRIMARY KEY,
    Price1 REAL,
    Price2 REAL,
    Price3 REAL,
    Price4 REAL,
    Price5 REAL
);

existingItems:
SELECT GUID FROM Products WHERE (Name = :name1 OR Alias = :alias1) OR (Name = :name2 OR Alias = :alias2);


insertItem:
INSERT OR IGNORE INTO Products (
    Name,
    Alias,
    PrintName,
    GroupName,
    GroupCode,
    UnitName,
    UnitCode,
    OpStk,
    OpStkValue,
    TaxCategory,
    TaxCategoryCode,
    SalesPrice,
    PurcPrice,
    MRP,
    MinSalesPrice,
    SelfValPrice,
    SaleDisc,
    PurcDisc,
    GUID,
    AltUnit,
    ConFactor,
    ConType,
    SalesPriceAlt,
    PurcPriceAlt
) VALUES (
    :name,
    :alias,
    :printName,
    :parentGroup,
    :parentGroupGuid,
    :mainUnit,
    :mainUnitGuid,
    :opQty,
    :opAmount,
    :taxCategoryName,
    :taxCategoryGuid,
    :salePrice,
    :purchPrice,
    :mrp,
    :minSalePrice,
    :selfValPrice,
    :saleDiscount,
    :purchDiscount,
    :product_guid,
    :altUnit,
    :conFactor,
    :conType,
    :salesPriceAlt,
    :purcPriceAlt
);

 getItemByName:
SELECT *
FROM Products
WHERE GUID IN (
    SELECT MasterCode1
    FROM Product_Param_Stock
    WHERE BCN = :itemName
      COLLATE NOCASE
) AND CAST(COALESCE(Products.E4, 0.0) AS REAL) <> -1.0
  AND CAST(COALESCE(Products.E5, 0.0) AS REAL) <> -1.0
UNION ALL
SELECT *
FROM Products
WHERE Name= :itemName AND (:filterGroup = 0 OR Products.GroupCode IN :groupCodes)
AND CAST(COALESCE(Products.E4, 0.0) AS REAL) <> -1.0
      AND CAST(COALESCE(Products.E5, 0.0) AS REAL) <> -1.0
  COLLATE NOCASE;


selectAllFilterAGRP:
SELECT * FROM Products
WHERE GroupCode IN ?
  AND GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
  AND CAST(COALESCE(Products.E4, 0.0) AS REAL) <> -1.0
        AND CAST(COALESCE(Products.E5, 0.0) AS REAL) <> -1.0
ORDER BY Name;

selectByGroupCode:
SELECT * FROM Products
WHERE GroupCode IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
  AND CAST(COALESCE(Products.E4, 0.0) AS REAL) <> -1.0
        AND CAST(COALESCE(Products.E5, 0.0) AS REAL) <> -1.0
ORDER BY Name;

selectExcludingGuid:
SELECT * FROM Products
WHERE GUID NOT IN ?
  AND (:applyN1Filter = 0 OR N1 > 0)
  AND CAST(COALESCE(Products.E4, 0.0) AS REAL) <> -1.0
        AND CAST(COALESCE(Products.E5, 0.0) AS REAL) <> -1.0
ORDER BY Name;

selectAll:
SELECT * FROM Products
WHERE (:applyN1Filter = 0 OR N1 > 0)
  AND CAST(COALESCE(Products.E4, 0.0) AS REAL) <> -1.0
  AND CAST(COALESCE(Products.E5, 0.0) AS REAL) <> -1.0
ORDER BY Name;

-- Distributor
productCategoriesForDis:
SELECT Name,GUID FROM ProductGroupMaster WHERE (:filterGroup = 0 OR ProductGroupMaster.GroupCode IN :groupCodes) ORDER BY Name;

getProductsForDis:
SELECT
    product_id,
    hospital_id,
    product_name,
    category_id,
    unit_id,
    effective_sales_price AS sales_price,
    effective_sales_price_alt AS sales_price_alt,
    effective_mrp AS MRP,
    effective_mrp_alt AS mrp_alt,
    purchase_price,
    effective_discount AS discount,
    effective_discount_alt AS discount_alt,
    gst_tax_percentage,
    product_description,
    created_at,
    updated_at,
    ROUND(
        CASE
            WHEN IFNULL(effective_discount, 0) = 0 THEN effective_sales_price
            ELSE effective_sales_price - (effective_sales_price * effective_discount / 100.0)
        END,
        2
    ) AS discounted_price,
    ROUND(
        CASE
            WHEN IFNULL(effective_discount_alt, 0) = 0 THEN effective_sales_price_alt
            ELSE effective_sales_price_alt - (effective_sales_price_alt * effective_discount_alt / 100.0)
        END,
        2
    ) AS discounted_price_alt,
    E4,
    E5,
    UnitName AS main_unit,
    AltUnit AS alt_unit,
    ConFactor AS con_factor,
    ConType AS con_type,
    PurcPriceAlt AS purc_price_alt,
    OF3,
    OF4,
    OF9,
    OF10,
    OF8,
    L6,
    brand_name
FROM (
    SELECT
        Products.GUID AS product_id,
        Products.GUID AS hospital_id,
        Products.Name AS product_name,
        Products.GroupCode AS category_id,
        Products.UnitCode AS unit_id,
        COALESCE(PP.SalesPrice, Products.SalesPrice) AS effective_sales_price,
        COALESCE(PP.SalesPriceAlt, Products.SalesPriceAlt) AS effective_sales_price_alt,
        COALESCE(PP.Mrp, Products.MRP) AS effective_mrp,
        COALESCE(PP.MrpAlt, Products.MRP) AS effective_mrp_alt,
        Products.PurcPrice AS purchase_price,
        Products.PurcPriceAlt,
        COALESCE(PP.Disc, Products.SaleDisc) AS effective_discount,
        COALESCE(PP.DiscAlt, Products.SaleDisc) AS effective_discount_alt,
        COALESCE(
            (
                SELECT IGST
                FROM Tax_Category_Mast
                WHERE Tax_Category_Mast.GUID = Products.TaxCategoryCode
                  AND AppDate <= '2025-04-01'
                ORDER BY AppDate DESC
                LIMIT 1
            ),
            0
        ) AS gst_tax_percentage,
        Products.Name AS product_description,
        '' AS created_at,
        '' AS updated_at,
        Products.UnitName,
        Products.AltUnit,
        Products.ConFactor,
        Products.ConType,
        Products.E4,
        Products.E5,
        Products.GroupCode,
        Products.GUID,
        Products.OF3,
        Products.OF4,
        Products.OF9,
        Products.OF10,
        Products.OF8,
        Products.L6,
        OFM.Name AS brand_name
    FROM Products
    LEFT JOIN Products_Pricing PP ON CAST(Products.GUID AS REAL) = CAST(PP.GUID AS REAL) AND CAST(PP.Srno AS REAL) = CAST(:changePrice AS REAL)
    LEFT JOIN OFMaster OFM ON CAST(Products.OF8 AS REAL) = OFM.Code
) AS Sub
WHERE (:filterGroup = 0 OR GroupCode IN :groupCodes) AND (:productCode IS NULL OR GroupCode = :productCode) AND ( E4 <> -1.0   OR  E4 IS NULL)
ORDER BY product_name;

